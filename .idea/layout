    // Section 2: Compilation
    src
      xec.cpp
    xec
      common
        dataclasslib // Library of common dataclasses e.g. ProcessedModule, SourceLocation, ConfigFile
        diagnostics // thread_local diagnostics builder
      ast
        astlib // Abstract Syntax Tree
        astprinter // [DEBUG] AST Printer
      token
        token // Token enum + struct Token + TokenStream + [DEBUG] token printer
      fsloader
        fsloader // Load file space
      lexer
        lexer // SourceCode -> TokenStream
      parser
        parser // TokenStream -> AST
      validation
        objects // Built-in types + RT object representations + ExportTable
        validators // Global Context + File Validator
      libloader
        libloader // Loads objects from .arinterface files and parses C++ templates
      codegen
        ir
          irlib // IR Commands + IRStream
          ir_builder // AST -> IRStream
        emitter // IRStream -> LLVM IR (user-gen.ll) + C++ (user-rt.cpp)
    runtime/
        include/
            xenon_rt.h          # Core type aliases (XENON_I64, XENON_STRING, Size)
            xenon_abi.h         # Common macro definitions for extern "C" linking 
        std/
            io/
                io.arinterface  # Public API (e.g., func writeln(text: String) -> Void)
                io.cpp          # C++ template with // @xenon:func(writeln) annotations
            linalg/
                linalg.arinterface # Public API (e.g., class Tensor<T>) [cite: 3]
                linalg.cpp         # C++ template with // @xenon:template(Tensor) [cite: 5]
            string/
                string.arinterface # Extension methods for your primitive String
                string.cpp         # Immutable helpers (e.g., xenon_string_concat)
        build_system/
            template_parser.py/cpp # Module Handler code that extracts annotated fragments
            bridge_generator.py/cpp# Backend phase that outputs the .bridge.cpp files