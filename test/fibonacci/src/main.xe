import "std/io"

module main;

func main() -> i32 {
    var nums: [int] = [0, 1];

    foreach i in range(1, 101) {
        let now = nums[i];
        let prev = nums[i-1];
        nums.append(now + prev);
    }

    io::writeln($"Fibonacci Sequence ({nums.size()} terms):");
    io::writeln(nums.Join(", "));
    return 0;
}
